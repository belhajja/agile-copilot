# Agile Copilot on a local machine (docker-compose.yml in this folder).
# Copy to .env next to docker-compose.yml, fill in the required values, then: docker compose up -d
# .env is read by Docker Compose only: paste values, it does not run $(...).

# --- Required ----------------------------------------------------------------------------------

# Where people open the app. Keep the port in sync with WEB_PORT below.
BETTER_AUTH_URL=http://localhost:3000
# Session signing secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Encrypts the stored Jira and AI credentials: v1:<openssl rand -base64 32>. Back it up with the
# database: without it those credentials cannot be read again.
ENCRYPTION_KEYS=
# Database passwords: URL-safe, no quotes (used unescaped in SQL and URLs): openssl rand -hex 24.
# APP_DB_PASSWORD only applies when the database volume is first created (see the README to change
# it later).
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# --- Images and ports --------------------------------------------------------------------------

# Images to run; empty = the latest develop build. Pin a release with the published images, e.g.
# registry.gitlab.tech.orange/mohamedamine.belhajja/jira-agentic-ai/web:v1.0.0 (and worker, migrate).
WEB_IMAGE=
WORKER_IMAGE=
MIGRATE_IMAGE=
# Port the app is published on, on this machine only (127.0.0.1).
WEB_PORT=3000
# A Docker Hub mirror for Postgres, e.g. dockerproxy.repos.tech.orange inside the Orange network.
# Empty = Docker Hub.
DOCKER_HUB_MIRROR=

# --- Jira ----------------------------------------------------------------------------------------

# Jira Data Center (or Ollama) hosts that resolve to private addresses, comma-separated, e.g.
# jira.corp.local. Outbound requests to private ranges are blocked otherwise.
ALLOWED_PRIVATE_HOSTS=
# The same hosts for the assistant's live Jira tools (mcp-atlassian). Once set, it is an allowlist
# for every Data Center host, public ones included: list them all.
MCP_ALLOWED_URL_DOMAINS=
# "Connect with Atlassian" (OAuth 2.0 3LO) for Jira Cloud; empty = API tokens only.
ATLASSIAN_OAUTH_CLIENT_ID=
ATLASSIAN_OAUTH_CLIENT_SECRET=
# Minutes between scheduled Jira syncs: 5, 10, 15, 30 or 60.
SYNC_INTERVAL_MINUTES=15

# --- Single sign-on (optional; README "Single sign-on") ------------------------------------------

# keycloak or oidc. SSO is off while OIDC_ISSUER is empty.
OIDC_PROVIDER=keycloak
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# The button label on the sign-in page.
OIDC_DISPLAY_NAME=SSO
# Who may sign in with a password: all, or admin_only.
PASSWORD_LOGIN=all
# Accounts that keep a password with PASSWORD_LOGIN=admin_only, comma-separated e-mails.
BREAK_GLASS_EMAILS=

# --- Limits -------------------------------------------------------------------------------------

# Requests per person per minute from external AI clients (MCP).
MCP_RATE_LIMIT_PER_MINUTE=60
# Reverse proxies in front of the app that append the client address to X-Forwarded-For:
# 0 when the app is reached directly (as published here), 1 behind one proxy. Behind a TLS reverse
# proxy it must be 1: with 0 every client shares one sign-in limit per account.
TRUSTED_PROXY_HOPS=0
# Background skill runs per workspace per day.
SKILL_RUNS_DAILY_LIMIT=50

# --- LLM tracing (optional; Langfuse, off unless both keys are set) -----------------------------

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Rarely changed -----------------------------------------------------------------------------

# selfhost: no billing and no plan limits. Leave as is.
DEPLOYMENT_MODE=selfhost
