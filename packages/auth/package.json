{
  "name": "@agile/auth",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./testing": "./src/testing/mock-oidc.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "generate-schema": "auth generate --config src/cli-config.ts --output ../db/src/schema/auth.ts --adapter drizzle --dialect postgresql --yes"
  },
  "dependencies": {
    "@agile/db": "workspace:*",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3"
  },
  "devDependencies": {
    "auth": "1.7.7",
    "next": "16.3.8",
    "oauth2-mock-server": "9.2.0",
    "testcontainers": "12.2.0",
    "yaml": "2.9.1"
  }
}
