# Generate secrets with: openssl rand -base64 32
DEPLOYMENT_MODE=selfhost
# App connects as the non-owner role (RLS applies to it)
DATABASE_URL=postgres://app_user:app_user_dev_password@localhost:5433/agile
# Migrations run as the owner
DATABASE_OWNER_URL=postgres://agile:agile_dev_password@localhost:5433/agile
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated versioned 32-byte keys, newest version wins: v1:<base64>,v2:<base64>
ENCRYPTION_KEYS=
# Hostnames allowed to resolve to private IPs (self-hosted Jira / Ollama), e.g. jira.corp.local
ALLOWED_PRIVATE_HOSTS=
# Optional: Atlassian OAuth 2.0 (3LO) app for "Connect with Atlassian"
ATLASSIAN_OAUTH_CLIENT_ID=
ATLASSIAN_OAUTH_CLIENT_SECRET=
# Agent: the shared mcp-atlassian instance (live Jira tools for Data Center PATs and Cloud OAuth).
# Trusted deployment setting: the app sends users' Jira tokens to this URL, so point it only at your
# own internal mcp-atlassian service, never at a third-party host.
# Development: http://127.0.0.1:4060/mcp (docker compose up -d mcp-atlassian). deploy/compose
# sets http://mcp-atlassian:8000/mcp for you. Unset = the agent still answers from synced data;
# Cloud API-token connections keep their live Jira tools (built in).
MCP_ATLASSIAN_URL=
# Skills: the read-only mcp-atlassian twin. Skill runs (worker) and previews (web) read live Jira only
# through it (Data Center PATs and Cloud OAuth); unset = they use synced data, plus the built-in
# read tools for Cloud API tokens. Development: http://127.0.0.1:4061/mcp
# (docker compose up -d mcp-atlassian-readonly); deploy/compose sets it for you.
MCP_ATLASSIAN_READONLY_URL=
# Skill runs (schedules, alerts, "Run now") per workspace and rolling 24 hours (default 50).
# SKILL_RUNS_DAILY_LIMIT=50
# mcp-atlassian only: Data Center hosts that resolve to private addresses. Empty = unset. Once set,
# it is an allowlist for every Data Center host, public ones included: list them all.
# Comma-separated, subdomains match, e.g. jira.corp.local,jira.example.com
MCP_ALLOWED_URL_DOMAINS=

# Single sign-on (optional): the deployment's OIDC identity provider. Set all three or none.
# OIDC_PROVIDER: keycloak (default) or oidc (any provider with discovery). Register the redirect
# URI <BETTER_AUTH_URL>/api/auth/callback/<keycloak|oidc> in the IdP. The issuer must be https
# (plain http only for localhost or ALLOWED_PRIVATE_HOSTS).
# Development Keycloak: docker compose --profile sso up -d keycloak, then
# OIDC_ISSUER=http://localhost:4100/realms/agile, OIDC_CLIENT_ID=agile-copilot,
# OIDC_CLIENT_SECRET=dev-only-client-secret
OIDC_PROVIDER=keycloak
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Label of the sign-in button ("Continue with <name>")
OIDC_DISPLAY_NAME=SSO
# all (default) or admin_only: passwords only for BREAK_GLASS_EMAILS (needs SSO and at least one
# address). Create those accounts with: pnpm --filter @agile/auth break-glass:create <email>
PASSWORD_LOGIN=all
# Platform admin accounts that keep a password (break-glass), comma-separated
BREAK_GLASS_EMAILS=

# External AI clients (MCP): requests per person per minute (all of a person's tokens together)
MCP_RATE_LIMIT_PER_MINUTE=60
# Reverse proxies in front of the app that append the client address to X-Forwarded-For (read by
# the sign-in and MCP limits): 0 when the app is reached directly (default), 1 behind one proxy or
# load balancer, 2 behind a CDN and then a proxy. Never more than are really there: clients could
# then choose their own address. Behind a TLS reverse proxy it must be 1: with 0 every client
# shares one sign-in limit per account, so anyone could keep an account locked.
TRUSTED_PROXY_HOPS=0

# LLM tracing to Langfuse (optional; off unless both keys are set). Prompts and answers are never
# sent. LANGFUSE_BASE_URL: your own Langfuse, if self-hosted (https).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Billing (SaaS only: DEPLOYMENT_MODE=saas). Set all three or none; self-host ignores them
# (deploy/compose does not pass them).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=
# Development and tests only: a stripe-mock URL (docker run -p 12111:12111 stripe/stripe-mock)
STRIPE_API_URL=

# Development. Running the published images on a machine uses deploy/compose/ and its own
# .env.example instead.

# Sync worker (apps/worker): minutes between scheduled Jira syncs (5, 10, 15, 30 or 60)
# SYNC_INTERVAL_MINUTES=15
# Port and interface of the worker's /health endpoint (deploy/compose sets 8080 on 0.0.0.0 inside
# the container and publishes nothing)
# WORKER_HEALTH_PORT=8080
# WORKER_HEALTH_HOST=127.0.0.1

# Optional: pull the dev compose file's Docker Hub images (Postgres, Mailpit) through a mirror,
# e.g. Orange's dockerproxy.repos.tech.orange. Unset: Docker Hub.
# DOCKER_HUB_MIRROR=dockerproxy.repos.tech.orange
