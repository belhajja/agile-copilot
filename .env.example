# Generate secrets with: openssl rand -base64 32
DEPLOYMENT_MODE=selfhost
# App connects as the non-owner role (RLS applies to it)
DATABASE_URL=postgres://app_user:app_user_dev_password@localhost:5433/agile
# Migrations run as the owner
DATABASE_OWNER_URL=postgres://agile:agile_dev_password@localhost:5433/agile
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated versioned 32-byte keys, newest version wins: v1:<base64>,v2:<base64>
ENCRYPTION_KEYS=
# Hostnames allowed to resolve to private IPs (self-hosted Jira / Ollama), e.g. jira.corp.local
ALLOWED_PRIVATE_HOSTS=
# Optional: Atlassian OAuth 2.0 (3LO) app for "Connect with Atlassian"
ATLASSIAN_OAUTH_CLIENT_ID=
ATLASSIAN_OAUTH_CLIENT_SECRET=

# Self-host compose only (docker-compose.selfhost.yml)
# Both must be URL-safe with no quotes (used unescaped in SQL and URLs): openssl rand -hex 24
# APP_DB_PASSWORD only applies when the DB volume is first created; see README to change it later.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# Host port the web container is published on (keep BETTER_AUTH_URL in sync)
WEB_PORT=3000

# Sync worker (apps/worker): minutes between scheduled Jira syncs (5, 10, 15, 30 or 60)
# SYNC_INTERVAL_MINUTES=15
# Port and interface of the worker's /health endpoint (the self-host compose sets 8080 on 0.0.0.0
# inside the container and publishes nothing)
# WORKER_HEALTH_PORT=8080
# WORKER_HEALTH_HOST=127.0.0.1
